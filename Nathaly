<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>San Valentín 💖</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: linear-gradient(135deg, #ff9a9e, #fad0c4);
            font-family: 'Poppins', sans-serif;
            text-align: center;
            flex-direction: column;
        }
        .hidden { display: none; }
        .btn {
            background: #ff4081;
            color: white;
            border: none;
            padding: 12px 25px;
            cursor: pointer;
            border-radius: 30px;
            font-size: 20px;
            margin: 10px;
            transition: 0.3s;
        }
        .btn:hover { background: #e91e63; }
    </style>
</head>
<body>
    <!-- Pantalla de bienvenida -->
    <div id="intro">
        <h1>💌 Te han enviado una carta 💌</h1>
        <button id="openCard" class="btn">Ver carta</button>
    </div>

    <!-- Pregunta de San Valentín -->
    <div id="question" class="hidden">
        <h1>¿Quieres ser mi San Valentín? 💕</h1>
        <button id="yes" class="btn">Sí 💘</button>
        <button id="no" class="btn">No 💔</button>
    </div>

    <!-- Mensaje de agradecimiento -->
    <div id="message" class="hidden">
        <h2>💖 ¡Gracias por ser mi San Valentín! 💖</h2>
        <p>🌹 Te amo con toda mi alma y quiero que seas mi San Valentín por siempre. 🌹</p>
    </div>

    <script>
        document.getElementById("openCard").addEventListener("click", function() {
            document.getElementById("intro").classList.add("hidden");
            document.getElementById("question").classList.remove("hidden");
        });

        document.getElementById("yes").addEventListener("click", function() {
            document.getElementById("question").classList.add("hidden");
            document.getElementById("message").classList.remove("hidden");
        });
    </script>
</body>
</html>
